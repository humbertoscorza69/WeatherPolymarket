MODE=live
LIVE_API_ENABLED=false
DRY_RUN_LIVE=true

# --- Market category ---
# DISCOVERY_MODE=weather  → hardcoded weather tag, uses CDF fair-value
# DISCOVERY_MODE=generic  → any Polymarket category via tag/URL, bypasses forecast
# DISCOVERY_PRESET options when mode=generic: weather, politics, sports, crypto, entertainment
# GAMMA_EVENTS_URL overrides the preset if you want a custom Gamma query
DISCOVERY_MODE=weather
DISCOVERY_PRESET=weather
# GAMMA_EVENTS_URL=
# BYPASS_FORECAST auto-set to true when DISCOVERY_MODE=generic
# BYPASS_FORECAST=false

# Scale knobs. Start with a few cities so we discover varied outcomes; the
# outcome-band filter (MIN/MAX_OUTCOME_MID) automatically discards extreme
# tail outcomes that have no spread for us to capture.
MAX_EVENTS=5
MAX_OUTCOMES_PER_EVENT=12
MIN_MARKET_VOLUME_USDC=0

WEATHER_API=open-meteo
WEATHER_UNCERTAINTY_C=1.5

# Pricing: pure market making.
#   HALF_SPREAD_TICKS=N  → bid = mid - N × market_tick (preferred — adapts across 0.001 and 0.01 tick markets)
#   HALF_SPREAD_CENTS=N  → bid = mid - N/100 (only used when HALF_SPREAD_TICKS=0)
# On a 0.001-tick market, HALF_SPREAD_CENTS=1 means 10 ticks below mid (way too wide).
# Default HALF_SPREAD_TICKS=1 means 1 tick below mid — the closest legal level.
HALF_SPREAD_TICKS=1
HALF_SPREAD_CENTS=1

# --- Capital sizing ---
# Three presets for different bankrolls. Uncomment the one that matches
# your deployed capital. ORDER_SIZE_USDC is a baseline that the adaptive
# sizer can scale up (capped by MAX_POSITION_PER_MARKET_USDC) to satisfy
# Polymarket's 5-share minimum at high-priced outcomes.

# $29 bankroll (starter / forward test):
ORDER_SIZE_USDC=2
MAX_POSITION_PER_MARKET_USDC=3
MAX_TOTAL_EXPOSURE_USDC=15

# $100 bankroll ("$5 on 20 markets" preset) — uncomment to use:
# ORDER_SIZE_USDC=3
# MAX_POSITION_PER_MARKET_USDC=5
# MAX_TOTAL_EXPOSURE_USDC=80

# $500 bankroll:
# ORDER_SIZE_USDC=5
# MAX_POSITION_PER_MARKET_USDC=15
# MAX_TOTAL_EXPOSURE_USDC=400

CLOB_MIN_SHARES=5
MAX_SHARES_PER_MARKET=5
REFRESH_INTERVAL_MS=30000
ORDER_POST_ONLY=true

# Safety: skip quotes where market mid drifts more than this from forecast
MAX_FORECAST_DIVERGENCE=0.20

# OFF = pure market making (recommended). ON = additionally cap bid at forecast fair value.
ENABLE_FAIR_VALUE_CAP=false

# Inventory skew: widen the BUY spread as open exposure approaches the cap.
# At 0% utilization: halfSpread = HALF_SPREAD_CENTS
# At 100%:           halfSpread = HALF_SPREAD_CENTS + INVENTORY_SKEW_CENTS
INVENTORY_SKEW_CENTS=2

# Realized-volatility widening (Avellaneda-Stoikov light).
# halfSpread += min(VOL_MAX_EXTRA_CENTS, VOL_MULTIPLIER × realized_stddev_cents)
# MC-selected default: VOL_MULTIPLIER=1.0 gives best adverse-regime Sharpe.
VOL_MULTIPLIER=1.0
VOL_MAX_EXTRA_CENTS=3
VOL_WINDOW_SIZE=60

# Drift filter: skip BUY quotes when the mid has been trending down.
# Addresses the "trend risk" failure mode: weather markets converge to the
# true outcome rather than oscillating, so MM buys get stuck above mid and
# stop out. The filter skips quotes when recent returns show persistent
# negative drift exceeding a t-stat threshold.
#   DRIFT_FILTER_DOWN_DRIFT_CENTS=N  skip if total drift over window is < -N cents
#   DRIFT_FILTER_RATIO=R             skip only if |drift|/stddev exceeds R (noise filter)
# Tune with the sweep — if the grid picks ENABLED=false, keep off.
DRIFT_FILTER_ENABLED=true
DRIFT_FILTER_MIN_SAMPLES=10
DRIFT_FILTER_DOWN_DRIFT_CENTS=2
DRIFT_FILTER_RATIO=1.2

# Take-profit ticks above entry. Default 1 = classic "lock one tick" MM exit.
# Set TP_VOL_MULTIPLIER>0 to widen TP in volatile markets: tp = base + floor(mult × vol_cents / tick_cents), capped at TP_TICKS_MAX.
# Warning: wider TP = slower fill = more stop-loss risk. See docs/MARKET_MAKING.md §14 for the tradeoff analysis.
TP_TICKS_BASE=1
TP_VOL_MULTIPLIER=0
TP_TICKS_MAX=5

# Stop-loss: hybrid ladder. Urgent rules → taker. Patient rules → try maker
# at bestAsk for STOP_LOSS_MAKER_EXIT_WAIT_SECONDS, then fall back to taker.
# See docs/MARKET_MAKING.md §3 for urgency classification.
STOP_LOSS_ENABLED=true
STOP_LOSS_CATASTROPHIC_DROP=0.30
STOP_LOSS_DEEP_DROP=0.60
STOP_LOSS_DEEP_DROP_MINUTES=120
STOP_LOSS_RESOLUTION_HOURS=1
STOP_LOSS_RESOLUTION_DROP=0.70
STOP_LOSS_MAX_HOLDING_HOURS=12
STOP_LOSS_MAKER_EXIT_WAIT_SECONDS=90

# Dashboard
DASHBOARD_PORT=8787
DASHBOARD_ENABLED=true

# Required only when LIVE_API_ENABLED=true and DRY_RUN_LIVE=false.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
