{
  "name": "polymarket-weather-mm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "start": "node --env-file=.env dist/src/main.js",
    "dry-run-live": "npm run build && node --env-file=.env dist/src/main.js",
    "live": "npm run build && node --env-file=.env dist/src/main.js",
    "simulate": "npm run build && node scripts/simulate.mjs",
    "backtest": "npm run build && node --env-file=.env scripts/backtest.mjs",
    "sweep": "npm run build && node --env-file=.env scripts/sweep.mjs",
    "analyze-markets": "npm run build && node --env-file=.env scripts/analyze-markets.mjs",
    "analyze-rewards": "npm run build && node --env-file=.env scripts/analyze-rewards.mjs",
    "stop-crypto": "powershell -ExecutionPolicy Bypass -File scripts/stop-crypto.ps1"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/ws": "^8.18.1",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "@ethersproject/wallet": "^5.8.0",
    "@polymarket/clob-client": "^5.8.1",
    "ws": "^8.20.0"
  }
}
