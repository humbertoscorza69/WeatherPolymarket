{
  "name": "polymarket-weather-mm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "backtest": "node scripts/backtest.mjs --threshold=0 --minentry=0.70 --maxentry=0.99 --bidoffset=0 --buywait=120 --stoplossmin=999 --stoplossdelta=0.9 --hardstopsec=1 --hardstopdelta=0.9 --declinelb=3600 --declinemax=0.9 --maxhold=240 --tradesize=40 --cooldown=0 --ttrmin=3600 --ttrmax=86400 --samplebucket=30 --filtertype=exact --filterunit=C --reqcrossed=true --crossedbuf=0.5 --rollingn=30 --rollingminwr=0.6 --allowyes=true --asymmetric=false",
    "detect": "node scripts/detect.mjs",
    "build-resolution-index": "node scripts/build-resolution-index.mjs",
    "fetch-weather-markets": "node scripts/fetch-yearly-weather-markets.mjs --days=365",
    "fetch-tick-history": "node scripts/fetch-tick-history-year.mjs --days=365",
    "fetch-weather-history": "node scripts/fetch-historical-weather.mjs",
    "fetch-metar": "node scripts/fetch-metar-observations.mjs",
    "fetch-resolved-markets": "npm run build && node --env-file=.env scripts/fetch-resolved-markets.mjs",
    "fetch-wallet-trades": "node scripts/fetch-wallet-trades.mjs",
    "fetch-more-wallets": "node scripts/fetch-more-wallets.mjs",
    "analyze-wallets": "node scripts/analyze-wallets.mjs",
    "validate-backtest": "node scripts/validate-backtest.mjs",
    "fetch-wallet-complete": "node scripts/fetch-wallet-complete.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/ws": "^8.18.1",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "@ethersproject/wallet": "^5.8.0",
    "@polymarket/clob-client": "^5.8.1",
    "ws": "^8.20.0"
  }
}
